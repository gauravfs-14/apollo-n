        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "lat": {
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "title": "Lon",
          "type": "number"
        },
        "why": {
          "minLength": 5,
          "title": "Why",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "lat",
        "lon",
        "why"
      ],
      "title": "CandidateSite",
      "type": "object"
    },
    "Checklist": {
      "additionalProperties": false,
      "properties": {
        "style": {
          "enum": [
            "quiz",
            "order_steps",
            "memory_match",
            "switch_panel"
          ],
          "title": "Style",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/ChecklistItem"
          },
          "maxItems": 8,
          "minItems": 3,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "style",
        "items"
      ],
      "title": "Checklist",
      "type": "object"
    },
    "ChecklistItem": {
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "minLength": 3,
          "title": "Prompt",
          "type": "string"
        },
        "answer": {
          "title": "Answer",
          "type": "string"
        },
        "options": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Options"
        },
        "fact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fact Id"
        }
      },
      "required": [
        "prompt",
        "answer"
      ],
      "title": "ChecklistItem",
      "type": "object"
    },
    "Constraints": {
      "additionalProperties": false,
      "properties": {
        "max_mass_kg": {
          "exclusiveMinimum": 0,
