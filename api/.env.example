SERPAPI_KEY=
LLM_PROVIDER=codex
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
VOICE_PROVIDER=system
ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_API_URL=
# LLM tuning (codex provider)
CODEX_MODEL=
CODEX_EFFORT=low
LLM_CONCURRENCY=2
# Voices (ElevenLabs voice ids). Defaults: Bill (CAPCOM), Brian (commander), Eric (LM pilot), Adam (PAO).
ELEVENLABS_VOICE_ID=
ELEVENLABS_CREW_VOICE_ID=
ELEVENLABS_LMP_VOICE_ID=
ELEVENLABS_PAO_VOICE_ID=
# eleven_multilingual_v2 (default, most natural) or eleven_v3 / eleven_flash_v2_5
ELEVENLABS_MODEL=
# speaking speed 0.7-1.2 (default 1.12; not used by eleven_v3)
ELEVENLABS_SPEED=
